@model JobPortal.ViewModels.ApplyJobViewModel

<h2>Apply for Job</h2>
<hr />

<form asp-action="Apply" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="JobId" />

    <div class="mb-3">
        <label asp-for="FullName"></label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ContactNumber"></label>
        <input asp-for="ContactNumber" class="form-control" />
        <span asp-validation-for="ContactNumber" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>Upload CV</label>
        <input asp-for="CvFile" type="file" class="form-control" />
        <span asp-validation-for="CvFile" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Submit Application</button>
    <a asp-action="Details" asp-route-id="@Model.JobId" class="btn btn-secondary">Cancel</a>
</form>
