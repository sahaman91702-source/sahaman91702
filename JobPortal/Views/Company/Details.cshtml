@model JobPortal.Models.Company

@{
    ViewData["Title"] = "Details";
}

<h2>Company Details</h2>
<hr />

<dl class="row">
    <dt class="col-sm-3">Company Name</dt>
    <dd class="col-sm-9">@Model.CompanyName</dd>

    <dt class="col-sm-3">Total Jobs</dt>
    <dd class="col-sm-9">@Model.Jobs?.Count ?? 0</dd>
</dl>

<hr />

<div class="mt-3">
    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-warning me-2">
        Edit
    </a>

    <a asp-action="Delete"
       asp-route-id="@Model.Id"
       class="btn btn-danger me-2">
        Delete
    </a>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back to List
    </a>
</div>
